{%- comment -%}
  Neue Montreal @font-face declarations.

  Kept out of assets/theme.css because the woff2 files have to be resolved
  through `asset_url`. The declarations themselves are identical to the ones
  served by the live storefront (six faces: 300/400/500, roman + italic).
{%- endcomment -%}
<style>
  @font-face {
    font-family: Neue Montreal;
    src: url({{ 'NeueMontreal-Light.woff2' | asset_url }}) format("woff2");
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: Neue Montreal;
    src: url({{ 'NeueMontreal-LightItalic.woff2' | asset_url }}) format("woff2");
    font-weight: 300;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: Neue Montreal;
    src: url({{ 'NeueMontreal-Regular.woff2' | asset_url }}) format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: Neue Montreal;
    src: url({{ 'NeueMontreal-Italic.woff2' | asset_url }}) format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: Neue Montreal;
    src: url({{ 'NeueMontreal-Medium.woff2' | asset_url }}) format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: Neue Montreal;
    src: url({{ 'NeueMontreal-MediumItalic.woff2' | asset_url }}) format("woff2");
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }
</style>
