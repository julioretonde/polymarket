{%- comment -%}
  Promo + products row.

  A large promo panel (image, heading, copy, CTA) beside a 2-up grid of product
  cards. `--halign-promo_products` puts the promo first, `--halign-products_promo`
  flips the pair; both instances on the home page use the same markup and only
  differ by that modifier.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign row_id = 'pb-row-promo-products-' | append: section.id
  assign widths = '576,768,1024,1200,1800,2400' | split: ','
-%}

{%- capture wrapper_class -%}
  {%- render 'pb-row-wrapper-class',
    pt: s.pt, pb: s.pb, pt_md: s.pt_md, pb_md: s.pb_md, pt_xl: s.pt_xl, pb_xl: s.pb_xl,
    mt: s.mt, mb: s.mb, mt_md: s.mt_md, mb_md: s.mb_md, mt_xl: s.mt_xl, mb_xl: s.mb_xl,
    text_color: s.text_color, bg_color: s.bg_color -%}
{%- endcapture -%}
{%- capture wrapper_style -%}
  {%- render 'pb-row-wrapper-style', zindex: s.zindex, text_color: s.text_color, bg_color: s.bg_color -%}
{%- endcapture -%}

<div class="shopify-block block-wrapper" id="shopify-block-{{ section.id }}__wrapper">
  <div class="{{ wrapper_class }}" style="{{ wrapper_style }}">
    <div class="pb-row pb-row-promo-products container-fluid d-grid grid-column-md-2 grid-gap-10 --halign-{{ s.layout }}" id="{{ row_id }}">
      <div class="pb-row-promo-products__promo col-start-1 row-start-md-1 w-100 d-grid" style="color:{{ s.promo_text_color }}">
        <figure class="pb-row-promo-products__promoMedia col-start-1 row-start-1 w-100 position-relative overflow-clip pointer-events-none">
          {%- if s.promo_image != blank -%}
            <img
              class="pb-row-promo-products__promoImg image-as-background"
              src="{{ s.promo_image | image_url: width: 2400 }}"
              srcset="{% for w in widths %}{%- assign wn = w | plus: 0 -%}{{ s.promo_image | image_url: width: wn }} {{ wn }}w{% unless forloop.last %},{% endunless %}{% endfor %}"
              sizes="(min-width: 768px) 50vw, 100vw"
              alt=""
              width="{{ s.promo_image.width }}"
              height="{{ s.promo_image.height }}"
              data-lazyload-target="#{{ row_id }} .pb-row-promo-products__promoMedia"
              loading="lazy">
          {%- endif -%}
        </figure>

        <div class="pb-row-promo-products__promoContent col-start-1 row-start-1 align-self-end position-relative d-grid grid-column-xl-2 col-gap-10 row-gap-20 row-gap-md-15 row-gap-xl-0">
          {%- if s.promo_title != blank -%}
            <h2 class="pb-row-promo-products__promoTitle col-start-1 row-start-1 fz-20 fz-md-32 fz-xl-40 fw-400 lh-normal m-0">{{ s.promo_title }}</h2>
          {%- endif -%}
          {%- if s.promo_text != blank -%}
            <div class="pb-row-promo-products__promoText col-start-xl-2 fz-14 row-start-2 fz-xl-15 fw-400 lh-17 lh-xl-normal wysiwyg">{{ s.promo_text }}</div>
          {%- endif -%}
          {%- if s.cta_label != blank -%}
            <a
              class="btn pb-row-promo-products__promoCTA col-start-xl-2 mt-md-5 mt-xl-25 row-start-3 --link"
              href="{{ s.cta_url }}"
              title=""
              aria-label="{{ s.cta_label | escape }}">
              <span class="btn__label" aria-hidden="true">{{ s.cta_label }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="pb-row-promo-products__products col-start-md-2 row-start-md-1 align-self-start d-grid grid-column-2 col-gap-10 row-gap-24 row-gap-md-10 row-gap-xl-12">
        {%- for block in section.blocks -%}
          {%- assign product = all_products[block.settings.product] -%}
          {%- if product != empty -%}
            {%- capture card_id -%}{{ row_id }}__product{{ forloop.index }}-{{ product.id }}{%- endcapture -%}
            {%- render 'product-preview',
              product: product,
              unique_id: card_id,
              class: 'pb-row-promo-products__product',
              rollover: true,
              show_colors: true -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo + products",
  "tag": "section",
  "class": "section--pb-row-promo-products",
  "max_blocks": 2,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Order",
      "options": [
        { "value": "promo_products", "label": "Promo, then products" },
        { "value": "products_promo", "label": "Products, then promo" }
      ],
      "default": "promo_products"
    },
    { "type": "image_picker", "id": "promo_image", "label": "Promo image" },
    { "type": "text", "id": "promo_title", "label": "Promo title", "default": "HEADWEAR" },
    { "type": "richtext", "id": "promo_text", "label": "Promo text" },
    { "type": "color", "id": "promo_text_color", "label": "Promo text colour", "default": "#ffffff" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Discover" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Row text colour" },
    { "type": "color", "id": "bg_color", "label": "Row background colour" },
    { "type": "header", "content": "Spacing" },
    { "type": "number", "id": "zindex", "label": "z-index", "default": 0 },
    { "type": "number", "id": "pt", "label": "Padding top (mobile)", "default": 0 },
    { "type": "number", "id": "pb", "label": "Padding bottom (mobile)", "default": 0 },
    { "type": "number", "id": "pt_md", "label": "Padding top (tablet)", "default": 0 },
    { "type": "number", "id": "pb_md", "label": "Padding bottom (tablet)", "default": 0 },
    { "type": "number", "id": "pt_xl", "label": "Padding top (desktop)", "default": 0 },
    { "type": "number", "id": "pb_xl", "label": "Padding bottom (desktop)", "default": 0 },
    { "type": "number", "id": "mt", "label": "Margin top (mobile)", "default": 10 },
    { "type": "number", "id": "mb", "label": "Margin bottom (mobile)", "default": 0 },
    { "type": "number", "id": "mt_md", "label": "Margin top (tablet)", "default": 10 },
    { "type": "number", "id": "mb_md", "label": "Margin bottom (tablet)", "default": 0 },
    { "type": "number", "id": "mt_xl", "label": "Margin top (desktop)", "default": 10 },
    { "type": "number", "id": "mb_xl", "label": "Margin bottom (desktop)", "default": 0 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [{ "name": "Promo + products", "blocks": [{ "type": "product" }, { "type": "product" }] }]
}
{% endschema %}
