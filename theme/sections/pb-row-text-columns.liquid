{%- comment -%}
  Text columns row.

  Four linked cards. From 768px up the `.swiper-wrapper` is restyled as a
  4-column grid by theme.css, so the row is a plain grid on tablet and desktop
  and a horizontally scrolling track on mobile.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign row_id = 'pb-row-text-columns-' | append: section.id
  assign widths = '576,768,1024,1200' | split: ','
-%}

{%- capture wrapper_class -%}
  {%- render 'pb-row-wrapper-class',
    pt: s.pt, pb: s.pb, pt_md: s.pt_md, pb_md: s.pb_md, pt_xl: s.pt_xl, pb_xl: s.pb_xl,
    mt: s.mt, mb: s.mb, mt_md: s.mt_md, mb_md: s.mb_md, mt_xl: s.mt_xl, mb_xl: s.mb_xl,
    text_color: s.text_color, bg_color: s.bg_color -%}
{%- endcapture -%}
{%- capture wrapper_style -%}
  {%- render 'pb-row-wrapper-style', zindex: s.zindex, text_color: s.text_color, bg_color: s.bg_color -%}
{%- endcapture -%}

<div class="shopify-block block-wrapper" id="shopify-block-{{ section.id }}__wrapper">
  <div class="{{ wrapper_class }}" style="{{ wrapper_style }}">
    <div class="pb-row pb-row-text-columns container-fluid swiper" id="{{ row_id }}" data-module="pb-row-text-columns">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="shopify-block block-text-column" id="shopify-block-{{ block.id }}__text_column" {{ block.shopify_attributes }}>
            <a class="text-column d-flex flex-column td-none" href="{{ b.url }}">
              {%- if b.title != blank -%}
                <h2 class="text-column__title fz-16 fz-xl-18 fw-400 lh-normal m-0">{{ b.title }}</h2>
              {%- endif -%}

              <figure class="text-column__media w-100 position-relative overflow-clip mb-10 mb-5 mb-xl-0">
                {%- if b.image != blank -%}
                  <img
                    class="text-column__img image-as-background"
                    src="{{ b.image | image_url: width: 1200 }}"
                    srcset="{% for w in widths %}{%- assign wn = w | plus: 0 -%}{{ b.image | image_url: width: wn }} {{ wn }}w{% unless forloop.last %},{% endunless %}{% endfor %}"
                    sizes="(min-width: 768px) 25vw, 75vw"
                    alt=""
                    width="{{ b.image.width }}"
                    height="{{ b.image.height }}"
                    data-lazyload-target=".pb-row-text-columns"
                    loading="lazy">
                {%- endif -%}
              </figure>

              {%- if b.text != blank -%}
                <div class="text-column__text fz-12 fz-md-13 fz-xl-14 fw-400 lh-15 lh-md-normal mr-15 wysiwyg">{{ b.text }}</div>
              {%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text columns",
  "tag": "section",
  "class": "section--pb-row-text-columns",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "text_color", "label": "Text colour" },
    { "type": "color", "id": "bg_color", "label": "Background colour" },
    { "type": "header", "content": "Spacing" },
    { "type": "number", "id": "zindex", "label": "z-index", "default": 0 },
    { "type": "number", "id": "pt", "label": "Padding top (mobile)", "default": 0 },
    { "type": "number", "id": "pb", "label": "Padding bottom (mobile)", "default": 0 },
    { "type": "number", "id": "pt_md", "label": "Padding top (tablet)", "default": 0 },
    { "type": "number", "id": "pb_md", "label": "Padding bottom (tablet)", "default": 0 },
    { "type": "number", "id": "pt_xl", "label": "Padding top (desktop)", "default": 0 },
    { "type": "number", "id": "pb_xl", "label": "Padding bottom (desktop)", "default": 0 },
    { "type": "number", "id": "mt", "label": "Margin top (mobile)", "default": 30 },
    { "type": "number", "id": "mb", "label": "Margin bottom (mobile)", "default": 20 },
    { "type": "number", "id": "mt_md", "label": "Margin top (tablet)", "default": 50 },
    { "type": "number", "id": "mb_md", "label": "Margin bottom (tablet)", "default": 40 },
    { "type": "number", "id": "mt_xl", "label": "Margin top (desktop)", "default": 40 },
    { "type": "number", "id": "mb_xl", "label": "Margin bottom (desktop)", "default": 70 }
  ],
  "blocks": [
    {
      "type": "text_column",
      "name": "Column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text columns",
      "blocks": [
        { "type": "text_column" },
        { "type": "text_column" },
        { "type": "text_column" },
        { "type": "text_column" }
      ]
    }
  ]
}
{% endschema %}
